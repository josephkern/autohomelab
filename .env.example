# Copy to .env (gitignored) and fill in.

# Hugging Face token — required for gated models, recommended for rate limits.
HF_TOKEN=

# Where model weights are cached (defaults to ~/.cache/huggingface if unset).
# HF_HOME=/path/to/large/disk/hf

# Backend server bind (the OpenAI-compatible endpoint the bench layer hits).
AHL_HOST=127.0.0.1
AHL_PORT=8000
